# ============================================================================
# ACNS-DSIG Environment Configuration for Supabase
# Copy this file to .env or set these in your terminal / hosting platform
# ============================================================================

# 1. Supabase Database Connection (from Project Settings -> Database -> Connection string -> URI)
# If using direct connection:
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# If using connection pooler (recommended for cloud):
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase DB User (Direct is usually "postgres", Pooler is "postgres.YOUR_PROJECT_REF")
SUPABASE_DB_USER=postgres
# The password you set when creating your Supabase database:
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# 2. Supabase API Keys (from Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
